  "styles": ".stage{min-height:20rem}",
  "sections": [
    {
      "id": "intro",
      "title": "&lt;av-finanzas&gt;",
      "lede": "La vista de finanzas completa. Sin sesión y empresa activa muestra su estado vacío; abajo, una pieza con datos de ejemplo.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"stage\"><av-finanzas id=\"d\"></av-finanzas></div>",
          "target": "#d",
          "props": {
            "id": null,
            "version": 0
          },
          "controls": [
            {
              "control": "select",
              "prop": "props:id",
              "label": "id (pestaña)",
              "options": [
                "",
                "general",
                "transacciones",
                "facturas"
              ],
              "default": null
            }
          ]
        },
        {
          "kind": "html",
          "html": "<iswc-callout color=\"brand\"><strong slot=\"title\">Cuándo usarlo</strong>Ruta finanzas (la monta av-app).</iswc-callout><iswc-callout color=\"warning\"><strong slot=\"title\">Cuándo no</strong>No dentro de otra vista.</iswc-callout>"
        }
      ]
    },
    {
      "id": "ejemplo",
      "title": "Con datos de ejemplo",
      "lede": "La pieza principal de la vista, sin API: los datos son fijos.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"stage\"><av-tabla id=\"tabla-transacciones\"></av-tabla></div>",
          "target": "#tabla-transacciones",
          "props": {
            "prefijo": "av-finanzas",
            "entidad": "transacciones",
            "columnas": [
              {
                "field": "fecha",
                "headerName": "Fecha",
                "width": 110
              },
              {
                "field": "tipo",
                "headerName": "Tipo",
                "width": 110
              },
              {
                "field": "categoria",
                "headerName": "Categoría",
                "flex": 0.9,
                "minWidth": 130
              },
              {
                "field": "descripcion",
                "headerName": "Descripción",
                "flex": 1.4,
                "minWidth": 180
              },
              {
                "field": "montoTexto",
                "headerName": "Monto",
                "flex": 0.9,
                "minWidth": 140
              },
              {
                "field": "estado",
                "headerName": "Estado",
                "width": 130
              }
            ],
            "idCampo": "itransaccion",
            "buscador": "Buscar por categoría, descripción, estado…",
            "vacio": {
              "icono": "mdi:swap-vertical-circle-outline",
