              "texto": "Registra ingresos y gastos para llevar la contabilidad."
            },
            "cargando": false,
            "texto": "",
            "puedeEscribir": true,
            "filas": [
              {
                "id": 5,
                "itransaccion": 5,
                "fecha": "2026-10-12",
                "tipo": "Gasto",
                "tipoClave": "gasto",
                "categoria": "Marketing",
                "descripcion": "Campaña redes sociales",
                "monto": 2400000,
                "montoTexto": "$ 2.400.000",
                "estado": "Completada",
                "estadoClave": "completada"
              },
              {
                "id": 2,
                "itransaccion": 2,
                "fecha": "2026-10-05",
                "tipo": "Ingreso",
                "tipoClave": "ingreso",
                "categoria": "Licencias",
                "descripcion": "Licencias anuales",
                "monto": 3200,
                "montoTexto": "US$ 3.200,00",
                "estado": "Completada",
                "estadoClave": "completada"
              }
            ]
          },
          "controls": [
            {
              "control": "boolean",
              "prop": "props:cargando",
              "label": "cargando",
              "default": false
            },
            {
              "control": "text",
              "prop": "props:texto",
              "label": "texto",
              "default": ""
            },
            {
              "control": "boolean",
              "prop": "props:puedeEscribir",
              "label": "puedeEscribir",
              "default": true
            }
          ]
        }
      ]
    }
