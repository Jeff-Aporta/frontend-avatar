{
  "$schema": "iswc-preview/v1",
  "tag": "av-rrhh",
  "category": "rrhh",
  "navTitle": "Recursos Humanos (shell)",
  "title": "&lt;av-rrhh&gt;",
  "titleHtml": false,
  "storageKey": "docs-av-rrhh",
  "styles": ".stage{min-height:20rem}",
  "sections": [
    {
      "id": "intro",
      "title": "&lt;av-rrhh&gt;",
      "lede": "La vista de RRHH completa. Sin sesión y empresa activa muestra su estado vacío; abajo, una pieza con datos de ejemplo.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"stage\"><av-rrhh id=\"d\"></av-rrhh></div>",
          "target": "#d",
          "props": {
            "id": null,
            "version": 0
          },
          "controls": [
            {
              "control": "select",
              "prop": "props:id",
              "label": "id (pestaña)",
              "options": [
                "",
                "general",
                "empleados",
                "asistencia",
                "solicitudes"
              ],
              "default": null
            }
          ]
        },
        {
          "kind": "html",
          "html": "<iswc-callout color=\"brand\"><strong slot=\"title\">Cuándo usarlo</strong>Ruta rrhh (la monta av-app).</iswc-callout><iswc-callout color=\"warning\"><strong slot=\"title\">Cuándo no</strong>No dentro de otra vista.</iswc-callout>"
        }
      ]
    },
    {
      "id": "ejemplo",
      "title": "Con datos de ejemplo",
      "lede": "La pieza principal de la vista, sin API: los datos son fijos.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"stage\"><av-tabla id=\"tabla-empleados\"></av-tabla></div>",
          "target": "#tabla-empleados",
          "props": {
            "prefijo": "av-rrhh",
            "entidad": "empleados",
            "columnas": [
              {
                "field": "nombre",
                "headerName": "Empleado",
                "flex": 1.3,
                "minWidth": 180
              },
              {
                "field": "email",
                "headerName": "Correo",
                "flex": 1.2,
                "minWidth": 180
              },
              {
                "field": "departamento",
                "headerName": "Departamento",
                "flex": 0.9,
                "minWidth": 130
              },
              {
                "field": "cargo",
                "headerName": "Cargo",
                "flex": 1.2,
                "minWidth": 170
              },
              {
                "field": "estado",
                "headerName": "Estado",
                "width": 120
              },
              {
                "field": "salarioTexto",
                "headerName": "Salario",
                "width": 140
              },
              {
                "field": "fingreso",
                "headerName": "Ingreso",
                "width": 110
              }
            ],
            "idCampo": "iempleado",
            "buscador": "Buscar por nombre, departamento, cargo…",
            "vacio": {
              "icono": "mdi:account-group-outline",
              "titulo": "Sin empleados",
              "texto": "Registra a las personas de la empresa."
            },
            "cargando": false,
            "texto": "",
            "puedeEscribir": true,
            "filas": [
              {
                "id": 1,
                "iempleado": 1,
                "nombre": "María Aguirre",
                "email": "maria@avatar.test",
                "departamento": "Diseño",
                "cargo": "Diseñadora Senior",
                "estado": "Activo",
                "estadoClave": "activo",
                "salario": 6500000,
                "salarioTexto": "$ 6.500.000",
                "fingreso": "2022-03-14"
              },
              {
                "id": 2,
                "iempleado": 2,
                "nombre": "Juan Rodríguez",
                "email": "juan@avatar.test",
                "departamento": "Desarrollo",
                "cargo": "Desarrollador Full-Stack",
                "estado": "Vacaciones",
                "estadoClave": "vacaciones",
                "salario": 7200000,
                "salarioTexto": "$ 7.200.000",
                "fingreso": "2021-08-02"
              }
            ]
          },
          "controls": [
            {
              "control": "boolean",
              "prop": "props:cargando",
              "label": "cargando",
              "default": false
            },
            {
              "control": "text",
              "prop": "props:texto",
              "label": "texto",
              "default": ""
            },
            {
              "control": "boolean",
              "prop": "props:puedeEscribir",
              "label": "puedeEscribir",
              "default": true
            }
          ]
        }
      ]
    }
