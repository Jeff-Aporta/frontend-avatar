              "control": "boolean",
              "prop": "props:puedeEscribir",
              "label": "puedeEscribir",
              "default": true
            }
          ]
        },
        {
          "kind": "html",
          "html": "<iswc-callout color=\"brand\"><strong slot=\"title\">Cuándo usarlo</strong>Para cualquier catálogo de una vista: su configuración vive en los utils de la vista.</iswc-callout><iswc-callout color=\"warning\"><strong slot=\"title\">Cuándo no</strong>No filtra por sí misma: la búsqueda la hace el shell. Las funciones de columna no viajan por JSON: aquí las celdas salen sin formato.</iswc-callout>"
        }
