      "id": "intro",
      "title": "&lt;av-tabla&gt;",
      "lede": "Buscador, grid del kit y estado vacío, configurados por props.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"stage\"><av-tabla id=\"tabla-empleados\"></av-tabla></div>",
          "target": "#tabla-empleados",
          "props": {
            "prefijo": "av-rrhh",
            "entidad": "empleados",
            "columnas": [
              {
                "field": "nombre",
                "headerName": "Empleado",
                "flex": 1.3,
                "minWidth": 180
              },
              {
                "field": "email",
                "headerName": "Correo",
                "flex": 1.2,
                "minWidth": 180
