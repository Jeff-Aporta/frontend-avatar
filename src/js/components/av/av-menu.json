                "contador": 0
              },
              {
                "id": "canales",
                "label": "Canales",
                "icon": "mdi:forum-outline",
                "grupo": "Trabajo",
                "contador": 3
              },
              {
                "id": "crm",
                "label": "CRM",
                "icon": "mdi:account-heart-outline",
