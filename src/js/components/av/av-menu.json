          "kind": "demo",
          "html": "<div class=\"stage\"><av-menu id=\"m\"></av-menu></div>",
          "target": "#m",
          "props": {
            "items": [
              {
                "id": "panel",
                "label": "Panel",
                "icon": "mdi:view-dashboard-outline",
