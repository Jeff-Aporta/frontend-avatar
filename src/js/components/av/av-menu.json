            "activo": "panel",
            "plegado": false
          },
          "controls": [
            {
              "prop": "props:plegado",
              "type": "boolean",
              "label": "plegado",
              "default": false
            },
            {
              "prop": "props:activo",
              "type": "select",
              "label": "activo",
              "options": [
                "panel",
                "canales",
                "crm"
              ],
              "default": "panel"
            }
          ]
        },
        {
          "kind": "html",
          "html": "<iswc-callout tone=\"info\"><strong slot=\"title\">Cuándo usarlo</strong>En el slot sidebar del shell, con sesión.</iswc-callout><iswc-callout tone=\"warning\"><strong slot=\"title\">Cuándo no</strong>No en la landing pública.</iswc-callout>"
        }
