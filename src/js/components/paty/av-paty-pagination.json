{
  "$schema": "iswc-preview/v1",
  "tag": "av-paty-pagination",
  "reuso": {
    "candidato": "iswc-root",
    "propuesta": "iswc-pagination",
    "motivo": "Paginador numérico con pista desplazable, sin datos de Paty."
  },
  "category": "paty",
  "navTitle": "Paginación",
  "title": "&lt;av-paty-pagination&gt;",
  "titleHtml": false,
  "storageKey": "docs-av-paty-pagination",
  "styles": ".caja{border:1px dashed var(--iswc-border);border-radius:12px;padding:.55rem .7rem}.angosto{width:min(100%,14rem);margin-inline:auto}.medio{width:min(100%,28rem);margin-inline:auto}.nota{margin:0 0 .4rem;font-size:.85em;color:var(--iswc-text-dim)}.grande{font-size:1.35em}.chico{font-size:.8em}.casos{display:grid;gap:.75rem;grid-template-columns:repeat(auto-fit,minmax(15rem,1fr))}.casos iswc-callout{height:100%}.casos iswc-callout::part(base){height:100%;box-sizing:border-box}.casos p{margin:.35em 0 0;opacity:.85;font-size:.92em;line-height:1.35}",
  "sections": [
    {
      "id": "intro",
      "title": "&lt;av-paty-pagination&gt;",
      "lede": "Fila que se desplaza. Las flechas, el dedo y Shift+rueda recorren las páginas.",
      "blocks": [
        {
          "kind": "demo",
          "heading": "Playground",
          "html": "<div class=\"caja medio\"><av-paty-pagination id=\"paginador-demo\" page=\"1\" pages=\"10\" total=\"120\" elements-per-page=\"15 30 50\" visible-elements-per-page=\"true\" variant=\"filled\" color=\"brand\" label=\"Paginación\"></av-paty-pagination></div>",
          "controls": [
            {
              "control": "number",
              "prop": "attr:page",
              "label": "page",
              "min": 1,
              "max": 20
            },
            {
              "control": "number",
              "prop": "attr:pages",
              "label": "pages",
              "min": 1,
              "max": 120
            },
            {
              "control": "select",
              "prop": "attr:visible-elements-per-page",
              "label": "visible-elements-per-page",
              "options": [
                "true",
                "false"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:disabled",
              "label": "disabled"
            },
            {
              "control": "text",
              "prop": "attr:label",
              "label": "label"
            },
            {
              "control": "select",
              "prop": "attr:variant",
              "label": "variant",
              "options": [
                "filled",
                "soft",
                "outlined",
                "ghost",
                "plain",
                "text"
              ]
            },
            {
              "control": "select",
              "prop": "attr:color",
              "label": "color",
              "options": [
                "brand",
                "neutral",
                "success",
                "warning",
                "danger",
                "info",
                "error"
              ]
            }
          ],
          "target": "#paginador-demo"
        },
        {
          "kind": "demo",
          "heading": "Tamaño medio, 100 páginas",
          "html": "<p class=\"demo-caption\">La pista muestra todos los números y se desplaza. Las flechas recorren la fila; el número cambia la página.</p><div class=\"caja medio\"><av-paty-pagination id=\"p-pagination\" page=\"12\" pages=\"100\" total=\"1500\" elements-per-page=\"15 30 50\" label=\"Cien páginas\"></av-paty-pagination></div>",
          "target": "#p-pagination"
        },
        {
          "kind": "demo",
          "heading": "Caja angosta",
          "html": "<p class=\"demo-caption\">Con poco ancho solo caben unos números. El resto se alcanza con las flechas, el dedo o Shift+rueda.</p><div class=\"caja angosto\"><av-paty-pagination id=\"p-pagination\" page=\"1\" pages=\"10\" total=\"120\" elements-per-page=\"15 30 50\" visible-elements-per-page=\"true\" label=\"Paginación\"></av-paty-pagination></div>",
          "target": "#p-pagination"
        },
        {
          "kind": "demo",
          "heading": "Tamaño fijo, sin selector",
          "html": "<p class=\"demo-caption\">Una sola opción en elements-per-page deja el tamaño fijo y no pinta el select.</p><div class=\"caja\"><av-paty-pagination id=\"p-pagination\" page=\"2\" pages=\"6\" elements-per-page=\"50\" label=\"Tamaño fijo\"></av-paty-pagination></div>",
          "target": "#p-pagination"
        },
        {
          "kind": "demo",
          "heading": "Sin selector de tamaño",
          "html": "<p class=\"demo-caption\">visible-elements-per-page false oculta el select aunque haya varias opciones.</p><div class=\"caja medio\"><av-paty-pagination id=\"p-pagination\" page=\"4\" pages=\"40\" total=\"600\" elements-per-page=\"15 30 50\" visible-elements-per-page=\"false\" label=\"Sin selector\"></av-paty-pagination></div>",
          "target": "#p-pagination"
        },
        {
          "kind": "demo",
          "heading": "Pocos elementos",
          "html": "<p class=\"demo-caption\">Si total es menor que el mínimo de la lista, el selector no se pinta.</p><div class=\"caja medio\"><av-paty-pagination id=\"p-pagination\" page=\"1\" pages=\"1\" total=\"8\" elements-per-page=\"15 30 50\" label=\"Pocos elementos\"></av-paty-pagination></div>",
          "target": "#p-pagination"
        },
        {
          "kind": "demo",
          "heading": "Tipografía 1.35em",
          "html": "<p class=\"demo-caption\">El componente escala con el font-size del contexto: chips, flechas y select.</p><div class=\"caja grande\"><av-paty-pagination id=\"p-pagination\" page=\"3\" pages=\"12\" total=\"120\" elements-per-page=\"10 20\" label=\"Grande\"></av-paty-pagination></div>",
          "target": "#p-pagination"
        },
        {
          "kind": "demo",
          "heading": "Tipografía 0.8em",
          "html": "<p class=\"demo-caption\">El mismo pie, más bajo, para columnas estrechas como el lateral del chat.</p><div class=\"caja chico medio\"><av-paty-pagination id=\"p-pagination\" page=\"8\" pages=\"24\" elements-per-page=\"30\" label=\"Chico\"></av-paty-pagination></div>",
          "target": "#p-pagination"
        },
        {
          "kind": "demo",
          "heading": "filled · brand",
          "html": "<p class=\"demo-caption\">Relleno sólido. Es el aspecto por defecto del número actual.</p><av-paty-pagination id=\"p-pagination\" variant=\"filled\" color=\"brand\" page=\"2\" pages=\"5\" visible-elements-per-page=\"false\" label=\"filled\"></av-paty-pagination>",
          "target": "#p-pagination"
        },
        {
          "kind": "demo",
          "heading": "soft · success",
          "html": "<p class=\"demo-caption\">Fondo del color con transparencia. El número queda en el mismo tono.</p><av-paty-pagination id=\"p-pagination\" variant=\"soft\" color=\"success\" page=\"2\" pages=\"5\" visible-elements-per-page=\"false\" label=\"soft\"></av-paty-pagination>",
          "target": "#p-pagination"
        },
        {
          "kind": "demo",
          "heading": "outlined · warning",
          "html": "<p class=\"demo-caption\">Anillo del color y fondo transparente.</p><av-paty-pagination id=\"p-pagination\" variant=\"outlined\" color=\"warning\" page=\"2\" pages=\"5\" visible-elements-per-page=\"false\" label=\"outlined\"></av-paty-pagination>",
          "target": "#p-pagination"
        },
        {
          "kind": "demo",
          "heading": "ghost · danger",
          "html": "<p class=\"demo-caption\">Anillo en reposo. Al pasar el cursor el número se rellena.</p><av-paty-pagination id=\"p-pagination\" variant=\"ghost\" color=\"danger\" page=\"2\" pages=\"5\" visible-elements-per-page=\"false\" label=\"ghost\"></av-paty-pagination>",
          "target": "#p-pagination"
        },
        {
          "kind": "demo",
          "heading": "plain · info",
          "html": "<p class=\"demo-caption\">Sin caja: solo tiñe el número.</p><av-paty-pagination id=\"p-pagination\" variant=\"plain\" color=\"info\" page=\"2\" pages=\"5\" visible-elements-per-page=\"false\" label=\"plain\"></av-paty-pagination>",
          "target": "#p-pagination"
        },
        {
          "kind": "demo",
          "heading": "text · neutral",
          "html": "<p class=\"demo-caption\">Número en el color del tema, sin borde ni fondo.</p><av-paty-pagination id=\"p-pagination\" variant=\"text\" color=\"neutral\" page=\"2\" pages=\"5\" visible-elements-per-page=\"false\" label=\"text\"></av-paty-pagination>",
          "target": "#p-pagination"
        },
        {
          "kind": "html",
          "html": "<div class=\"casos\"><iswc-callout color=\"success\" icon=\"mdi:check-circle-outline\"><strong>Cuándo usarlo</strong><p>Debajo de un catálogo paginado. Las flechas recorren la fila y el número cambia la página.</p></iswc-callout><iswc-callout color=\"danger\" icon=\"mdi:alert-octagon-outline\"><strong>Cuándo no</strong><p>No pagines dentro de la tabla. Este tag es solo el pie.</p></iswc-callout></div>"
        },
        {
          "kind": "html",
          "propuesta": true,
          "html": "<iswc-callout tone=\"warning\"><strong slot=\"title\">Propuesto para iswc: iswc-pagination</strong>Paginador numérico con pista desplazable, sin datos de Paty. Viene de PatyIA. Pendiente de aprobación.</iswc-callout>"
        }
      ]
    }
  ],
  "origen": "ISW-TestPatyIA"
}
